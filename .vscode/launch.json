{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug sorter: prompt for input",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Aaron_Sound_Sorter.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        "sort",
        "${input:inputPath}",
        "${input:outputPath}",
        "--brain",
        "${workspaceFolder}/stage4_folder_brain.json"
      ],
      "justMyCode": false
    },
    {
      "name": "Debug sorter: FX_Aaron2 full ZIP",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Aaron_Sound_Sorter.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        "sort",
        "/Volumes/T9/music_production/samples/FX_Aaron2.zip",
        "${workspaceFolder}/outputs/debug_fx_aaron2",
        "--brain",
        "${workspaceFolder}/stage4_folder_brain.json"
      ],
      "justMyCode": false
    },
    {
      "name": "Debug sorter: Percussion ZIP",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Aaron_Sound_Sorter.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        "sort",
        "/Volumes/T9/music_production/samples/one_shot_percussive_sounds.zip",
        "${workspaceFolder}/outputs/debug_percussion",
        "--brain",
        "${workspaceFolder}/stage4_folder_brain.json"
      ],
      "justMyCode": false
    },
    {
      "name": "Debug sorter: self-test",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/Aaron_Sound_Sorter.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/src"
      },
      "args": [
        "self-test"
      ],
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "inputPath",
      "type": "promptString",
      "description": "Input WAV, folder, or ZIP path",
      "default": "/Volumes/T9/music_production/samples/FX_Aaron2.zip"
    },
    {
      "id": "outputPath",
      "type": "promptString",
      "description": "Output folder path",
      "default": "${workspaceFolder}/outputs/debug_prompt_sort"
    }
  ]
}