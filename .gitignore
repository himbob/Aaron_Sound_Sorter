# Python generated files
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.coverage
htmlcov/
build/
dist/

# Local Python environments
.venv/
.venv_*/
venv/
env/

# macOS and editor metadata
.DS_Store
._*
.vscode/

# Generated project output
outputs/
output/
reports/
_reports/
_real_sort_tests/
_pytest_outputs/
_pytest_regression_outputs/
Aaron_Sorted_Sounds/
Aaron_Test_Cases/
test_output/
sorted_output/
source_cache/
**/source_cache/

# Local training data and generated training runs
training/
_training_data/
_balanced_baby_training/
stage4_brain_family_training/run_*/
stage4_folder_brain_training/

# Keep only the two pinned runtime neural model snapshots.
# Their large files are tracked through Git LFS in .gitattributes.
_models/*
!_models/laion_larger_clap_music_and_speech/
!_models/laion_larger_clap_music_and_speech/**
!_models/mert_v1_95m_7d1bb4c/
!_models/mert_v1_95m_7d1bb4c/**
_models/**/.cache/
_models/**/cache/
_models/**/logs/
_models/**/*backup*
_models/**/*archive*

# Keep only compact runtime neural prototype and prompt indexes.
# Embedding caches, curation runs, GUI imports/inboxes, and reports stay local.
neural_artifacts/*
!neural_artifacts/prototype_indexes/
!neural_artifacts/prototype_indexes/**
!neural_artifacts/prompt_indexes/
!neural_artifacts/prompt_indexes/**
neural_artifacts/prototype_indexes/**/.cache/
neural_artifacts/prototype_indexes/**/*backup*
neural_artifacts/prototype_indexes/**/*archive*
neural_artifacts/prompt_indexes/**/.cache/
neural_artifacts/prompt_indexes/**/*backup*
neural_artifacts/prompt_indexes/**/*archive*
_neural_cache/
_neural_runs/

# Active root brain JSON files are intentionally tracked.
# Ignore only clear backup/archive copies of those brains.
stage4_*brain*.bak
stage4_*brain*.bak.*
stage4_*brain*_backup*.json
stage4_*brain*-backup*.json
stage4_*brain*_old*.json
stage4_*brain*-old*.json
stage4_*brain*_archiv*.json
stage4_*brain*-archiv*.json

# Local sample audio and package archives are not repository assets.
*.wav
*.aif
*.aiff
*.au
*.flac
*.ogg
*.mp3
*.m4a
*.aac
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
*.rar

# Preserve executable command sources beneath otherwise generated names.
!commands/build/
!commands/build/*.command
!commands/training/
!commands/training/*.command
_models/**/.git/
_models/**/.github/
_models/**/__pycache__/
